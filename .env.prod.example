DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret

POSTGRES_DB=fashion_rental
POSTGRES_USER=fashion_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5

ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_NAME=Atelier Rental
SITE_URL=https://example.com
CONTACT_EMAIL=atelier@example.com
CONTACT_PHONE=+994 00 000 00 00
CONTACT_LOCATION=Baku · by appointment
NOTIFY_EMAIL=atelier@example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=atelier@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Atelier Rental <atelier@example.com>

# Turn these on only after HTTPS is configured at Nginx / reverse proxy.
SECURE_SSL_REDIRECT=0
SECURE_COOKIES=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
HTTP_PORT=80
LOG_LEVEL=INFO

# Keep 1 for the first launch to import /dresses and demo media; set to 0 afterwards if you edit catalog data manually.
SEED_DEMO=1
